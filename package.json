{
  "name": "world6-rpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server scripts vite.config.ts",
    "preview": "vite preview",
    "test": "node scripts/test-rules.mjs",
    "dev:all": "node --env-file-if-exists=server/.env scripts/dev-all.mjs",
    "server:build": "node scripts/build-server-rules.mjs",
    "server": "node --env-file-if-exists=server/.env server/index.mjs",
    "start": "node server/index.mjs",
    "test:server": "node scripts/build-server-rules.mjs && node --test server/test/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
