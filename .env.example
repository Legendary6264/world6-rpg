# Public frontend build settings only. Never add tokens or database credentials.
# Empty API URL uses the same origin (Vite proxies /api and /socket.io locally).
VITE_API_URL=
# Optional canonical address for metadata. Empty until the address is chosen.
# Does not redirect visitors or change Supabase callbacks.
VITE_SITE_URL=
# Current deployment example:
# VITE_API_URL=https://world6-api.onrender.com
# VITE_SITE_URL=https://legendary6264.github.io/world6-rpg/
